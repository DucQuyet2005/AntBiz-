{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "backend/**/*.ts",
    "backend/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "contexts/**/*.ts",
    "contexts/**/*.tsx",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "*.ts",
    "*.tsx",
    "*.mts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scratch",
    "e2e",
    ".next/dev"
  ]
}
