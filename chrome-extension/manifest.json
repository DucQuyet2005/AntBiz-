{
  "manifest_version": 3,
  "name": "AntBiz Assistant",
  "version": "1.0.0",
  "description": "Tiện ích đồng bộ tài khoản và tự động trích xuất nội dung bài viết từ các trang tin tức gửi về AntBiz.",
  "permissions": [
    "activeTab",
    "cookies",
    "storage",
    "scripting",
    "tabs",
    "audioCapture"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://172.25.240.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AntBiz Assistant",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
